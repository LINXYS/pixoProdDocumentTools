# External-Postgres Docker env.
# Use this when Postgres already exists and Docker should only start project workers.
# FTP/FTPS/SFTP settings remain in each project's config.yaml under ingestion.remote_source.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/VECTOR_DB
RECORD_MANAGER_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/RECORD_MANAGER_DB

OPENAI_API_KEY=

# CPU-first default. Set to auto only when using docker-compose.external-db.gpu.yml.
PIXO_ACCELERATOR=cpu

# Run ingestion immediately on container startup, then repeat every hour.
RUN_ON_START=true
INGESTION_INTERVAL_SECONDS=3600
DB_WAIT_TIMEOUT_SECONDS=120
