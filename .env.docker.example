# Full-stack Docker env.
# Use this when docker-compose.yml starts its own local Postgres/pgvector container.
# For SciArc with an already-existing Postgres database, use .env.sciarc.example instead.

POSTGRES_PASSWORD=change_this_password

OPENAI_API_KEY=

# Default: CPU-first scheduled ingestion.
PIXO_ACCELERATOR=cpu
INGESTION_INTERVAL_SECONDS=3600
RUN_ON_START=true
DB_WAIT_TIMEOUT_SECONDS=120
