# Copy this to .env on the VM and fill in real values.
# The Compose file reads these values at runtime; they are not baked into images.

POSTGRES_PASSWORD=change_this_password

OPENAI_API_KEY=
COHERE_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Default: CPU-first scheduled ingestion.
PIXO_ACCELERATOR=cpu
INGESTION_INTERVAL_SECONDS=3600
RUN_ON_START=true
DB_WAIT_TIMEOUT_SECONDS=120
